{
  "name": "usurahi",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "slack:bridge": "node slack-bridge.js",
    "autopilot:start": "bash ./scripts/autopilot.sh start",
    "autopilot:stop": "bash ./scripts/autopilot.sh stop",
    "autopilot:status": "bash ./scripts/autopilot.sh status",
    "school:cycle": "node ./scripts/school-cycle.mjs --force",
    "school:watch": "node ./scripts/school-watch.mjs --apply",
    "library:maintain": "node ./scripts/library-maintain.mjs",
    "library:shelf": "node ./scripts/library-shelf.mjs",
    "school:status": "node ./scripts/generate-school-status.mjs",
    "dashboard:dev": "npm --prefix ./dashboard run dev",
    "dashboard:build": "node ./scripts/generate-school-status.mjs && npm --prefix ./dashboard run build && node ./scripts/publish-school-dashboard.mjs",
    "dashboard:e2e": "npm --prefix ./dashboard run test:e2e",
    "test": "node --import tsx --test test/*.test.ts && npm --prefix ./dashboard test",
    "typecheck": "tsc --noEmit",
    "library:add": "tsx scripts/library-add.ts",
    "meeting:liveness": "node scripts/conversation-liveness.mjs",
    "meeting:highlight": "node scripts/meeting-highlight.mjs --print",
    "reception:status": "bash ./usurahi.sh status",
    "tutorial": "bash ./usurahi.sh tutorial"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "dotenv": "^17.2.4",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
